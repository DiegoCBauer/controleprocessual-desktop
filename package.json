{
  "name": "controle-processual-desktop",
  "productName": "Controle Processual",
  "version": "1.0.0",
  "description": "Aplicativo desktop do Controle Processual — C&K Advogados",
  "author": "C&K Advogados",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "br.com.clezarkuchler.controleprocessual",
    "productName": "Controle Processual",
    "artifactName": "ControleProcessual-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle Processual",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DiegoCBauer",
        "repo": "controleprocessual-desktop"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
